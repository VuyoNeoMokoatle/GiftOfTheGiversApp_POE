@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container py-5">
        <h1 class="display-3 text-warning fw-bold">Welcome to Gift of the Givers</h1>
        <p class="lead text-light mt-3">
            We strive to make a difference in communities through relief projects and donations.
        </p>
        <div class="mt-4">
            <a asp-controller="ReliefProjects" asp-action="Index" class="btn btn-primary btn-lg mx-2">View Projects</a>
            <a asp-controller="Donations" asp-action="Index" class="btn btn-success btn-lg mx-2">Donate Now</a>
        </div>
    </div>
</section>

<!-- About Us Section -->
<section class="about-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <img src="~/images/about-us.jpg" class="img-fluid rounded shadow-lg" alt="About Gift of the Givers" />
            </div>
            <div class="col-md-6">
                <h2 class="text-warning fw-bold">About Us</h2>
                <p class="text-light mt-3">
                    Gift of the Givers is Africa's largest independent humanitarian organization,
                    committed to providing disaster relief, humanitarian aid, and community support.
                    We empower communities through sustainable projects, healthcare, education, and disaster response.
                </p>
                <p class="text-light">
                    Our vision is to transform lives and restore hope where it’s needed the most.
                    Join us in making a real impact today.
                </p>
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-warning mt-3">Learn More</a>
            </div>
        </div>
    </div>
</section>
