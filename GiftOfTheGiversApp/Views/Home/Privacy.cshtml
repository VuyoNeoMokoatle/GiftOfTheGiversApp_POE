@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-section py-5">
    <div class="container">
        <h1 class="display-4 text-warning fw-bold text-center mb-4">Privacy Policy</h1>
        <p class="text-light">
            Your privacy is important to us at Gift of the Givers. We are committed to protecting your personal information
            and ensuring transparency about how your data is collected, stored, and used.
        </p>

        <h3 class="text-warning mt-4">Information We Collect</h3>
        <p class="text-light">
            We may collect information such as your name, email address, donation history, and any other data you provide
            voluntarily when using our services.
        </p>

        <h3 class="text-warning mt-4">How We Use Your Information</h3>
        <p class="text-light">
            The data collected is used to process donations, communicate important updates, provide personalized services,
            and improve our platform. We never sell or rent your personal information.
        </p>

        <h3 class="text-warning mt-4">Data Security</h3>
        <p class="text-light">
            We implement industry-standard security measures to protect your data. While we strive to safeguard information,
            no transmission over the internet is 100% secure.
        </p>

        <h3 class="text-warning mt-4">Your Rights</h3>
        <p class="text-light">
            You have the right to access, correct, or delete your personal information. Contact us for any privacy concerns.
        </p>

        <h3 class="text-warning mt-4">Contact Us</h3>
        <p class="text-light">
            For questions regarding this Privacy Policy, please reach out to <strong>info@giftofthegivers.org</strong>.
        </p>
    </div>
</section>
