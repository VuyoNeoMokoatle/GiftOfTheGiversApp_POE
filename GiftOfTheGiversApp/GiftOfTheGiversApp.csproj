		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Areas\Identify\Controllers\" />
	  <Folder Include="Areas\Identify\Data\" />
	  <Folder Include="Areas\Identify\Models\" />
	  <Folder Include="Areas\Identify\Views\" />
	</ItemGroup>

</Project>

